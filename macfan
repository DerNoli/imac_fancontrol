#!/bin/bash
export LC_ALL=C

# hwmon-Verzeichnis des applesmc anhand des Namens finden (Nummer ändert sich pro Boot)
HW=""
for d in /sys/class/hwmon/hwmon*; do
    if [ "$(cat "$d/name" 2>/dev/null)" = "applesmc" ]; then
        HW="$d"
        break
    fi
done
if [ -z "$HW" ]; then
    logger -t macfan "applesmc hwmon nicht gefunden, Abbruch."
    exit 1
fi

# Temperatursensoren per Label (SMC-Key), Fallback auf Nummer.
# Label sind case-sensitiv: TG0d (temp25) != TG0D (temp19)
CPU_LABEL="TCXc"
GPU_LABEL="TG0d"
CPU_FALLBACK="$HW/temp17_input"
GPU_FALLBACK="$HW/temp25_input"

find_temp() {
    local label="$1" fallback="$2" f
    for f in "$HW"/temp*_label; do
        if [ "$(cat "$f" 2>/dev/null)" = "$label" ]; then
            echo "${f%_label}_input"
            return
        fi
    done
    echo "$fallback"
}

CPU_TEMP=$(find_temp "$CPU_LABEL" "$CPU_FALLBACK")
GPU_TEMP=$(find_temp "$GPU_LABEL" "$GPU_FALLBACK")

# Lüfter-Dateien
FAN_TARGET="$HW/fan1_target"
FAN_ENABLE="$HW/pwm1_enable"
FAN_MIN_FILE="$HW/fan1_min"

# Fan curve parameters
MIN_FAN=1200
MAX_FAN=4000

# Ab Linux 7.3 ist fan1_max read-only.
# 1 = MAX_FAN auch dann verwenden, wenn es über fan1_max liegt
# 0 = MAX_FAN auf fan1_max begrenzen
FORCE_MAX=1

# Hardware-Grenzen einlesen
HW_MIN=$(cat "$FAN_MIN_FILE")
HW_MAX=$(cat "$HW/fan1_max")
ORIG_MIN=$HW_MIN
MIN_CHANGED=0

# Max
if [ "$MAX_FAN" -gt "$HW_MAX" ]; then
    if [ "$FORCE_MAX" -eq 1 ]; then
        logger -t macfan "MAX_FAN $MAX_FAN liegt über fan1_max $HW_MAX, schreibe trotzdem."
    else
        logger -t macfan "MAX_FAN $MAX_FAN liegt über fan1_max $HW_MAX, begrenze auf $HW_MAX."
        MAX_FAN=$HW_MAX
    fi
fi

# Min: fan1_min ist schreibbar -> nur absenken, wenn Hardware-Minimum höher liegt
if [ "$MIN_FAN" -lt "$HW_MIN" ]; then
    if echo "$MIN_FAN" > "$FAN_MIN_FILE" 2>/dev/null; then
        MIN_CHANGED=1
        logger -t macfan "fan1_min von $HW_MIN auf $MIN_FAN gesetzt."
    else
        logger -t macfan "fan1_min nicht schreibbar, nutze Hardware-Minimum $HW_MIN."
        MIN_FAN=$HW_MIN
    fi
fi

# Temperature range for smooth ramp
MIN_TEMP=40
MAX_TEMP=65

# Weighting
GPU_WEIGHT=0.7
CPU_WEIGHT=0.4

# Logarithmic curve aggressiveness
K=0.12

HYSTERESIS=10
LAST_FAN=0

# Beim Beenden zurück auf SMC-Automatik (2) und ursprüngliches Minimum
cleanup() {
    echo 2 > "$FAN_ENABLE"
    [ "$MIN_CHANGED" -eq 1 ] && echo "$ORIG_MIN" > "$FAN_MIN_FILE" 2>/dev/null
    logger -t macfan "MacFan beendet, Lüfter wieder auf Automatik (fan1_min=$ORIG_MIN)."
}
trap cleanup EXIT
trap 'exit 0' INT TERM

# Manuellen Modus aktivieren
echo 1 > "$FAN_ENABLE" || { logger -t macfan "pwm1_enable nicht schreibbar"; exit 1; }

logger -t macfan "$(date '+%d.%m.%Y %H:%M:%S') MacFan started (CPU=$CPU_TEMP GPU=$GPU_TEMP, MIN=$MIN_FAN MAX=$MAX_FAN, HW_MIN=$HW_MIN HW_MAX=$HW_MAX) with GPU-weighted logarithmic fan curve."

while true; do
    RAW_CPU=$(cat "$CPU_TEMP")
    RAW_GPU=$(cat "$GPU_TEMP")

    CPU=$((RAW_CPU / 1000))
    GPU=$((RAW_GPU / 1000))

    # Weighted temperature
    TEMP=$(printf "%.0f" "$(echo "$CPU * $CPU_WEIGHT + $GPU * $GPU_WEIGHT" | bc -l)")

    # Logarithmic fan curve
    if [ "$TEMP" -le "$MIN_TEMP" ]; then
        MODE="IDLE"
        FAN=$MIN_FAN

    elif [ "$TEMP" -ge "$MAX_TEMP" ]; then
        MODE="LOAD"
        FAN=$MAX_FAN

    else
        MODE="LOG"
        X=$(echo "$TEMP - $MIN_TEMP" | bc -l)
        RANGE=$(echo "$MAX_TEMP - $MIN_TEMP" | bc -l)
        SCALE=$(echo "($MAX_FAN - $MIN_FAN) / l(1 + $K * $RANGE)" | bc -l)
        FAN_FLOAT=$(echo "$MIN_FAN + l(1 + $K * $X) * $SCALE" | bc -l)
        FAN=$(printf "%.0f" "$FAN_FLOAT")
    fi

    # Log every tick
    logger -t macfan "$(date '+%d.%m.%Y %H:%M:%S') Temps: CPU=${CPU}°C GPU=${GPU}°C WGT=${TEMP}°C MODE=${MODE} FAN=${FAN}"

    # Hysteresis
    DIFF=$(( FAN - LAST_FAN ))
    if [ "${DIFF#-}" -gt "$HYSTERESIS" ]; then
        if echo "$FAN" > "$FAN_TARGET" 2>/dev/null; then
            LAST_FAN=$FAN
            logger -t macfan "$(date '+%d.%m.%Y %H:%M:%S') Fan set to ${FAN} RPM (MODE=${MODE})"
        else
            logger -t macfan "Schreiben von ${FAN} RPM nach fan1_target fehlgeschlagen."
        fi
    fi

    sleep 2
done
